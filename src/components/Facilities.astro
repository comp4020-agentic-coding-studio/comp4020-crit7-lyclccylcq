---
import type { Room } from "../lib/schema";

interface Props {
  room: Pick<Room, "hasPower" | "isAccessible" | "hasDisplay" | "hasWhiteboard" | "deviceType">;
}

// Only verified facilities (true) are shown; null means not verified.
const { room } = Astro.props;
const facilities = [
  room.hasPower && { key: "power", label: "Power" },
  room.isAccessible && { key: "accessible", label: "Accessible" },
  room.hasDisplay && { key: "display", label: "Display" },
  room.hasWhiteboard && { key: "whiteboard", label: "Whiteboard" },
].filter((facility): facility is { key: string; label: string } => Boolean(facility));

// Computer desks: what's on the desk, always as text beside the icon.
const EQUIPMENT = {
  mac: "Mac",
  windows: "Windows PC",
  monitor: "External monitor",
  none: "No supplied equipment",
};
const device = room.deviceType;
---

{facilities.length > 0 && (
  <ul class="facilities" aria-label="Facilities">
    {facilities.map((facility) => (
      <li>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          {facility.key === "power" && <path d="M9 1.5 3.5 9H7.5L6.5 14.5 12.5 7H8.5Z" />}
          {facility.key === "accessible" && (
            <>
              <circle cx="8.5" cy="2.5" r="1.25" />
              <path d="M8.5 5v4.25h3l1.5 3.75M8.5 7h3M6.25 7.5a3.75 3.75 0 1 0 4.5 5" />
            </>
          )}
          {facility.key === "display" && <path d="M1.5 2.5h13v8.5h-13ZM5 14h6M8 11v3" />}
          {facility.key === "whiteboard" && <path d="M1.5 2.5h13v9h-13ZM4.5 14l1.5-2.5M11.5 14 10 11.5M4.5 8l2.5-2 2 1.5 2.5-2" />}
        </svg>
        {facility.label}
      </li>
    ))}
  </ul>
)}

{device && (
  <ul class="facilities equipment" aria-label="Equipment">
    <li>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        {(device === "mac" || device === "windows") && <path d="M2.5 3h11v7.5h-11ZM1 13h14M6.5 10.5v2.5M9.5 10.5v2.5" />}
        {device === "monitor" && <path d="M1.5 2.5h13v8.5h-13ZM5 14h6M8 11v3" />}
        {device === "none" && <path d="M8 1.75a6.25 6.25 0 1 0 0 12.5 6.25 6.25 0 1 0 0-12.5ZM3.6 3.6l8.8 8.8" />}
      </svg>
      {EQUIPMENT[device]}
    </li>
  </ul>
)}
