---
import "../styles.css";

interface Props {
  title: string;
  current?: "search" | "bookings" | "about";
}

const { title, current } = Astro.props;
const links = [
  { href: "/", label: "Find a space", page: "search" },
  { href: "/bookings", label: "My bookings", page: "bookings" },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">ANU Library <span>Study spaces</span></a>
        <nav aria-label="site">
          {links.map((link) => (
            <a href={link.href} aria-current={link.page === current ? "page" : undefined}>{link.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
