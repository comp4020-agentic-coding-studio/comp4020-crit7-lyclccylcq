---
import Facilities from "../components/Facilities.astro";
import Layout from "../layouts/Layout.astro";
import { findAvailableRooms } from "../lib/bookings";
import { durationLabel, fullTimeRange, peopleLabel, shortDate, timeRange } from "../lib/format";
import { canberraNow, DURATIONS, LIBRARIES, PARTY_SIZES, parseSearch, searchDefaults } from "../lib/search";

const params = Astro.url.searchParams;
const parsed = parseSearch(params);
const query = parsed && "query" in parsed ? parsed.query : null;
const error = parsed && "error" in parsed ? parsed.error : null;
const results = query ? findAvailableRooms(query) : [];
const selectedDuration = params.get("duration") ?? "60";
const defaults = searchDefaults();
const today = canberraNow().date;
const selectedPeople = params.get("people") ?? "1";
const when = query ? timeRange(query.start, query.endTime.slice(11)) : "";
const cardTime = query ? fullTimeRange(query.start, query.endTime.slice(11)) : "";
const selectedLibrary = params.get("library") ?? "any";
const libraryCount = new Set(results.map((room) => room.library)).size;
const roomsLabel = `${results.length} ${results.length === 1 ? "room" : "rooms"} available`;
const scope = !query
  ? ""
  : query.library
    ? ` at ${query.library}`
    : libraryCount > 1
      ? ` across ${libraryCount} libraries`
      : results.length > 0
        ? ` at ${results[0].library}`
        : "";
---

<Layout title="Find a study room — ANU Library" current="search">
  <section class="intro" aria-labelledby="page-heading">
    <p class="eyebrow">Chifley · Hancock · Law</p>
    <h1 id="page-heading">When do you need a room?</h1>
    <p class="lede">Tell us when and how many. You'll only see rooms you can actually book.</p>

    <form class="search" method="get" action="/">
      <div class="field">
        <label for="date">Date</label>
        <input id="date" name="date" type="date" required min={today} value={params.get("date") ?? defaults.date} />
      </div>
      <div class="field">
        <label for="start">Start time</label>
        <input id="start" name="start" type="time" step="1800" required value={params.get("start") ?? defaults.start} />
      </div>
      <div class="field">
        <label for="duration">Duration</label>
        <select id="duration" name="duration">
          {DURATIONS.map((minutes) => (
            <option value={minutes} selected={String(minutes) === selectedDuration}>
              {durationLabel(minutes)}
            </option>
          ))}
        </select>
      </div>
      <div class="field">
        <label for="people">People</label>
        <select id="people" name="people">
          {PARTY_SIZES.map((count) => (
            <option value={count} selected={String(count) === selectedPeople}>{peopleLabel(count)}</option>
          ))}
        </select>
      </div>
      <div class="field field-library">
        <label for="library">Library</label>
        <select id="library" name="library">
          <option value="any" selected={selectedLibrary === "any"}>Any library</option>
          {LIBRARIES.map((library) => (
            <option value={library.value} selected={library.value === selectedLibrary}>{library.name}</option>
          ))}
        </select>
      </div>
      <button class="search-button">Find rooms</button>
    </form>

    {error && <p class="notice notice-error" role="alert">{error}</p>}
  </section>

  {query ? (
    <section class="results" aria-labelledby="results-heading">
      <header class="results-header">
        <h2 id="results-heading">
          {results.length === 0 ? `No rooms available${scope}` : `${roomsLabel}${scope}`}
        </h2>
        <p class="results-context">
          For {peopleLabel(query.people)} · {shortDate(query.date)} · {when}
        </p>
      </header>

      {results.length > 0 ? (
        <ul class="room-grid">
          {results.map((room) => (
            <li class="room-card">
              <h3>{room.name}</h3>
              <p class="room-place">
                {room.level && `${room.level} · `}{room.library}
              </p>
              <Facilities room={room} />
              <p class="room-facts">
                <span>Up to {peopleLabel(room.capacity)}</span>
                <span>{cardTime}</span>
              </p>
              <form method="get" action="/bookings/confirm">
                <input type="hidden" name="roomId" value={room.id} />
                <input type="hidden" name="date" value={query.date} />
                <input type="hidden" name="start" value={query.start} />
                <input type="hidden" name="duration" value={query.duration} />
                <input type="hidden" name="people" value={query.people} />
                <input type="hidden" name="library" value={selectedLibrary} />
                <button class="book-button" aria-label={`Book ${room.name}`}>
                  Book room <span aria-hidden="true">→</span>
                </button>
              </form>
            </li>
          ))}
        </ul>
      ) : (
        <p class="notice">
          Nothing is free for that time and group size. Try a different start time, a shorter booking, a
          smaller group or another library.
        </p>
      )}
    </section>
  ) : (
    !error && (
      <section class="empty" aria-labelledby="empty-heading">
        <h2 id="empty-heading">Find the room that fits your plans.</h2>
        <p>Choose when you need a space and we'll only show rooms that are actually available.</p>
      </section>
    )
  )}
</Layout>

