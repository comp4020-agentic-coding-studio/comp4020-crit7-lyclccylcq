---
import { findAvailableRooms } from "../lib/bookings";
import { DURATIONS, parseSearch } from "../lib/search";
import "../styles.css";

const params = Astro.url.searchParams;
const parsed = parseSearch(params);
const query = parsed && "query" in parsed ? parsed.query : null;
const error = parsed && "error" in parsed ? parsed.error : null;
const results = query ? findAvailableRooms(query) : [];
const selectedDuration = params.get("duration") ?? "60";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Find a study room — ANU Library</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Find a room</a>
      <a href="/bookings">My bookings</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Find a study room</h1>
      <form method="get" action="/">
        <label for="date">Date</label>
        <input id="date" name="date" type="date" required value={params.get("date") ?? ""} />

        <label for="start">Start time</label>
        <input id="start" name="start" type="time" step="1800" required value={params.get("start") ?? ""} />

        <label for="duration">Duration</label>
        <select id="duration" name="duration">
          {DURATIONS.map((minutes) => (
            <option value={minutes} selected={String(minutes) === selectedDuration}>{minutes} minutes</option>
          ))}
        </select>

        <label for="people">People</label>
        <input id="people" name="people" type="number" min="1" required value={params.get("people") ?? "1"} />

        <button>Find available rooms</button>
      </form>

      {error && <p role="alert">{error}</p>}

      {query && (
        <section aria-labelledby="results-heading">
          <h2 id="results-heading">
            Free on {query.date}, {query.start}–{query.endTime.slice(11)}, for {query.people}
          </h2>
          {results.length > 0 ? (
            <ul>
              {results.map((room) => (
                <li>
                  {room.name} — {room.library}, seats {room.capacity}
                  <form method="post" action="/bookings">
                    <input type="hidden" name="roomId" value={room.id} />
                    <input type="hidden" name="date" value={query.date} />
                    <input type="hidden" name="start" value={query.start} />
                    <input type="hidden" name="duration" value={query.duration} />
                    <button aria-label={`Book ${room.name}`}>Book</button>
                  </form>
                </li>
              ))}
            </ul>
          ) : (
            <p>No rooms are free for that time. Try another start time or a shorter booking.</p>
          )}
        </section>
      )}
    </main>
  </body>
</html>
