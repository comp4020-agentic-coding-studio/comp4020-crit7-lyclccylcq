---
import StatusPanel from "../../components/StatusPanel.astro";
import Layout from "../../layouts/Layout.astro";
import { cancelBooking } from "../../lib/bookings";

if (Astro.request.method !== "POST") return Astro.redirect("/bookings", 303);

const form = await Astro.request.formData();
const bookingId = Number(form.get("bookingId"));
if (Number.isInteger(bookingId) && bookingId > 0 && cancelBooking(bookingId)) {
  return Astro.redirect("/bookings?cancelled=1", 303);
}
Astro.response.status = 404;
---

<Layout title="Booking not found — ANU Library" current="bookings">
  <StatusPanel
    title="Booking not found"
    message="It may already have been cancelled."
    actions={[
      { href: "/bookings", label: "My bookings" },
      { href: "/", label: "Find a space" },
    ]}
  />
</Layout>
